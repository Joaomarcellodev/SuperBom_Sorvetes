# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Publishable key (sb_publishable_...). O nome antigo NEXT_PUBLIC_SUPABASE_ANON_KEY também funciona.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-publishable-key-aqui

# PIX para receber das vendas (QR Code e copia e cola gerados no aparelho, funciona offline).
# Celular no formato +55DDDNUMERO; também aceita e-mail, CPF/CNPJ ou chave aleatória.
NEXT_PUBLIC_PIX_KEY=+5586999999999
# Nome e cidade do recebedor (até 25 e 15 letras, sem acento)
NEXT_PUBLIC_PIX_NAME=MAXBONO SORVETES
NEXT_PUBLIC_PIX_CITY=TERESINA
